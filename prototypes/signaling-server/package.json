{
  "name": "rylaide-signaling",
  "version": "0.1.0",
  "description": "Signaling server for rider mesh intercom app - relays WebRTC offers/answers/ICE candidates and manages ride groups. Carries no audio itself.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.14.0"
  }
}
